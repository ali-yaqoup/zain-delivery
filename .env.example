# Copy to .env.local (local) and Vercel Environment Variables (production)

# REQUIRED — primary admin login (/admin). No hardcoded fallback.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-before-handover

# Optional extra admins (email:password, separated by |)
# ADMIN_USERS=staff@example.com:another-password
# Or numbered vars: ADMIN_EMAIL1 / ADMIN_PASSWORD1 (set Production, not only Development)

# Optional: secret for order tracking links (defaults to ADMIN_PASSWORD if unset)
# ORDER_TRACK_SECRET=long-random-string

# Web Push for admin PWA (Production on Vercel). Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Public site URL (SEO / Open Graph) — set after domain is ready
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Postgres connection (required for production deploy)
# Neon / Supabase / any Postgres URI
# Without DATABASE_URL the app falls back to local JSON files (dev only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
