# Copy to .env.local (local) and Vercel Environment Variables (production)

# REQUIRED in production — admin panel password (/admin). No hardcoded fallback.
ADMIN_PASSWORD=change-me-before-handover

# Optional: secret for order tracking links (defaults to ADMIN_PASSWORD if unset)
# ORDER_TRACK_SECRET=long-random-string

# Public site URL (SEO / Open Graph) — set after domain is ready
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Postgres connection (required for production deploy)
# Neon / Supabase / any Postgres URI
# Without DATABASE_URL the app falls back to local JSON files (dev only).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
